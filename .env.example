# Backend
PORT=3000
NODE_ENV=development
# Required; supplied privately, never committed. For a fresh private secret:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
MAIL_DOMAIN=phonemail.com
AUTH_METHOD=password
CORS_ORIGIN=http://localhost:8080,http://localhost:8081
PHONE_DEFAULT_COUNTRY=

# PostgreSQL
POSTGRES_USER=phonemail
POSTGRES_PASSWORD=
POSTGRES_DB=phonemail
# Compose constructs DATABASE_URL using the db service automatically.
# For a non-Docker backend, set your private local database connection here.
DATABASE_URL=

# Client URLs
VITE_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public frontend build configuration (not credentials). Use approved published
# legal pages and the backend's matching consent version; do not invent approval.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_TERMS_VERSION=
VITE_IVR_PUBLIC_NUMBER=
VITE_IVR_REGISTRATION_ENABLED=false
VITE_IVR_SIGNIN_READY=false

# Optional telecom provider integration; leave empty for local fixture-only operation
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_APPROVED_TEMPLATE_SID=
TWILIO_PUBLIC_URL=
TWILIO_TIMEOUT_MS=5000

# OTP provider selection; local is development-only and never proves phone ownership
OTP_PROVIDER=local
OTP_TTL_MS=300000
OTP_RESEND_COOLDOWN_MS=30000
OTP_MAX_ATTEMPTS=5
OTP_CODE_HASH_SECRET=
OTP_WEBHOOK_SECRET=
OTP_WEBHOOK_TOLERANCE_MS=300000

# Local API operations
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_INTERVAL_MS=5000
MAINTENANCE_INTERVAL_MS=60000
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
UPLOAD_QUOTA_BYTES=52428800
UPLOAD_CONCURRENT_LIMIT=3

# SMTP is disabled unless explicitly configured. Use file only for labeled local simulation.
MAIL_TRANSPORT_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000
SMTP_MAX_CONNECTIONS=2
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_INBOUND_ENABLED=false
SMTP_INBOUND_HOST=0.0.0.0
SMTP_INBOUND_PORT=2525
SMTP_INBOUND_MAX_CLIENTS=20
SMTP_INBOUND_AUTH_USER=
SMTP_INBOUND_AUTH_PASSWORD=
SMTP_INBOUND_TRUSTED_PEERS=
SMTP_INBOUND_TLS_KEY=
SMTP_INBOUND_TLS_CERT=
