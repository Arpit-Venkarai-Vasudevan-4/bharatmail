# Server-side development/preview proxy; never a browser credential.
API_PROXY_TARGET=http://localhost:3000
# Production registration remains blocked until approved content matches the API.
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_TERMS_VERSION=

# Public inbound registration configuration. Never include provider secrets.
VITE_IVR_PUBLIC_NUMBER=
VITE_IVR_REGISTRATION_ENABLED=false
# Enable only after the final backend supports login for call-created accounts.
VITE_IVR_SIGNIN_READY=false
# Optional archived translation review, never needed for English launch.
VITE_TRANSLATION_PREVIEW=false
