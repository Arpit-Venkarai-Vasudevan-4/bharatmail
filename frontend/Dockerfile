FROM node:24.21.0-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ARG VITE_TERMS_URL
ARG VITE_PRIVACY_URL
ARG VITE_TERMS_VERSION
ARG VITE_PORTAL=false
ARG VITE_IVR_PUBLIC_NUMBER
ARG VITE_IVR_REGISTRATION_ENABLED=false
ARG VITE_IVR_SIGNIN_READY=false
ENV VITE_TERMS_URL=$VITE_TERMS_URL VITE_PRIVACY_URL=$VITE_PRIVACY_URL VITE_TERMS_VERSION=$VITE_TERMS_VERSION VITE_PORTAL=$VITE_PORTAL
ENV VITE_IVR_PUBLIC_NUMBER=$VITE_IVR_PUBLIC_NUMBER VITE_IVR_REGISTRATION_ENABLED=$VITE_IVR_REGISTRATION_ENABLED VITE_IVR_SIGNIN_READY=$VITE_IVR_SIGNIN_READY
RUN npm run build
FROM nginx:1.28-alpine
COPY --from=build /app/dist /usr/share/nginx/html
ENV API_PROXY_TARGET=http://backend:3000
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
